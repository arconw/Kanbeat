Screen { background: #0b1019; color: #d9e4f3; }
StartupScreen { background: #0b1019; align: center middle; }
#startup-wordmark { width: auto; height: 3; text-style: bold; text-align: center; content-align: center middle; }
#startup-subtitle { width: auto; height: 1; color: #8d9fb4; text-align: center; }
#root { height: 100%; width: 100%; }
Button { height: 1; min-width: 8; border: none; padding: 0 1; }
#nav {
    height: 2;
    padding: 0 1;
    background: #141d2c;
    align-vertical: middle;
    border-bottom: solid #334257;
}
#brand { width: 16%; min-width: 22; height: 1; }
#logo { width: auto; height: 1; text-style: bold; color: #7ee5d5; }
#brand #terminal-heading { width: 1fr; height: 1; padding-left: 1; color: #9eafc2; text-wrap: nowrap; text-overflow: ellipsis; }
#terminal-controls { width: auto; height: 1; display: none; }
#terminal-controls Button { height: 1; min-width: 7; margin-right: 1; }
#nav-spacer { width: 1fr; }
#diff-toggle { width: auto; min-width: 9; height: 1; margin-right: 1; background: #213447; color: #9becdc; }
#diff-toggle.selected { background: #2f5f9e; color: #ffffff; text-style: bold; }
#diff-toggle.diff-unseen { color: #ffd479; text-style: bold; }
#diff-toggle.diff-pulse { background: #3f6aa0; color: #ffffff; }
.-narrow #brand { width: 16%; min-width: 18; }
.-narrow .nav-button { min-width: 0; padding: 0; }
.-narrow #terminal-controls Button { min-width: 6; margin-right: 0; }
.-narrow #quit { min-width: 7; }
.-narrow #diff-toggle { min-width: 6; margin-right: 0; padding: 0; }
.nav-button { height: 1; min-width: 11; border: none; color: #9eafc2; background: #141d2c; }
.nav-button.selected { color: #7ee5d5; background: #213447; text-style: bold; }
#execution { height: 1; min-width: 11; }
#quit { height: 1; min-width: 9; margin-left: 1; }
#content { height: 1fr; width: 100%; }
#bottom { height: 1; padding-left: 2; color: #92a2b4; background: #1c293b; }
#board-page { height: 100%; }
.toolbar { height: 2; background: #111b2b; align-vertical: middle; padding: 0 1; }
.toolbar Button { height: 1; min-width: 12; margin-left: 1; }
.page-heading { height: 1; width: 1fr; content-align-vertical: middle; text-style: bold; }
#lanes { height: 1fr; width: 100%; padding: 1; overflow-x: auto; }
.lane {
    min-width: 30;
    width: 1fr;
    height: 100%;
    margin-right: 1;
    padding: 1;
    background: #131e2e;
}
.lane-title { text-style: bold; color: #8fa9c6; height: 2; }
.card { height: auto; background: #202e41; padding: 1; margin-bottom: 1; }
.card:focus-within { background: #263d55; }
.card-title { width: 1fr; min-width: 5; background: transparent; border: none; color: #f2f7fd; text-align: left; content-align: left middle; padding: 0; height: auto; }
.card-bar { height: 1; width: 100%; }
.card-step { width: 5; min-width: 5; height: 1; padding: 0; margin-right: 1; border: none; background: #324861; color: #9becdc; }
.card-step:disabled { background: #1c2a3c; color: #4b5d73; }
.card-menu { width: 4; min-width: 4; padding: 0; border: none; background: #324861; color: #9becdc; }
.card-summary { padding: 0 1; color: #aebed2; height: auto; }
.card-links { padding: 0 1; color: #f2c94c; height: auto; }
.card-runtime { padding: 0 1; color: #80dccc; height: auto; }
.check-button { border: none; background: #263b4d; }
#archive-page, #settings {
    height: 100%;
    padding: 1 2;
}
#sessions-page { height: 100%; layers: base overlay; }
#sessions-side { width: 20%; min-width: 34; height: 100%; layer: base; }
#sessions-list { height: 1fr; padding: 1 1; }
#sessions-footer { height: 1; padding: 0 1; }
#sessions-footer Button { width: 1fr; min-width: 10; }
#sessions-list .slot-row { layout: grid; grid-size: 2; grid-gutter: 0 1; height: auto; }
#sessions-list .slot-name { column-span: 2; width: 100%; height: auto; margin: 0; padding: 0 1; }
#sessions-list .task-status { column-span: 2; width: 100%; height: auto; }
#sessions-list .slot-row Button { width: 100%; min-width: 0; margin: 0; }
.session-row { height: auto; margin: 0 2 1 0; background: #1d2b3d; }
#sessions-list .card-title { content-align: left middle; text-align: left; padding: 0 1; }
.session-side { width: 4; height: auto; }
.session-state { width: 4; height: 1; content-align: center middle; }
.state-ok { color: #5ee08a; }
.state-busy { color: #f2c94c; }
.state-warn { color: #ff9f43; }
.state-error { color: #ff5d6c; }
.state-idle { color: #6b7c93; }
.session-row:hover { background: #26405a; }
.session-row.active-session { background: #2b4a63; }
.section-head { height: 1; width: 100%; padding-right: 2; }
.section-head CollapsibleTitle { width: 1fr; height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
.group-menu { height: 1; width: 5; min-width: 5; padding: 0; border: none; background: #324861; color: #9becdc; }
TerminalPane { width: 1fr; height: 100%; layer: base; }
#terminal-body { height: 100%; }
#terminal-empty { width: 100%; height: 100%; content-align: center middle; color: #8d9fb4; }
.archive-row { height: 1; margin-bottom: 1; align-vertical: middle; background: #1b2a3a; }
.archive-title { width: 1fr; padding: 0 1; content-align-vertical: middle; }
.session-heading, .section-title {
    text-style: bold;
    color: #b0a0ff;
    margin: 1 0;
}
.field { color: #95a8bf; margin-top: 1; text-style: bold; }
.field-row { height: 3; align-vertical: middle; }
.field-row Select { width: 1fr; }
.field-row Button { min-width: 10; margin-left: 1; }
.settings-editor { height: 7; margin-bottom: 1; }
.hint { color: #8d9fb4; padding: 1; height: auto; }
.runtime { color: #7be0d1; min-width: 13; width: auto; height: 1; content-align: center middle; background: #142839; margin: 0 1; text-style: bold; }
.slot-row { height: 1; align-vertical: middle; background: #1d2b3d; margin-bottom: 1; }
.slot-name { width: 1fr; min-width: 14; content-align-vertical: middle; padding-left: 1; margin-right: 1; }
.slot-row Button { min-width: 10; margin-right: 1; }
.task-status { width: 28; min-width: 15; height: 1; padding: 0 1; color: #7be0d1; content-align-vertical: middle; overflow-x: hidden; }
.agent-working.agent-pulse { color: #b8f6e5; }
BackdropModal {
    align: center middle;
    background: #050a12 85%;
}
.full {
    width: 100%;
    height: 100%;
    background: #101b2a;
    border: none;
    padding: 0;
}
.content { height: 1fr; padding: 1 2; }
.modal-header {
    height: 1;
    background: #223146;
    align-vertical: middle;
    padding: 0 1;
}
.modal-name { width: 1fr; text-style: bold; color: #82ead9; content-align-vertical: middle; }
.modal-header Button { height: 1; min-width: 8; }
#close { width: 3; min-width: 3; padding: 0; }
#no { width: 3; min-width: 3; padding: 0; }
#close, #no, #diff-close { background: #b3263e; color: #ffffff; text-style: bold; }
#close:hover, #no:hover, #diff-close:hover { background: #d63a52; }
.sm {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    background: #182638;
    padding: 1;
}
.sm TextArea { height: 7; }
SessionActions, GroupActions, ColumnMenu, SourceMenu { align: left top; background: transparent; }
.menu { width: 34; height: auto; background: #182638; padding: 1; }
.menu Button { width: 100%; min-width: 0; height: 1; border: none; margin: 0; padding: 0 1; background: #223146; content-align: left middle; text-align: left; }
.menu Button:hover, .menu Button:focus { background: #2f4660; text-style: bold; }
.menu Button:disabled { color: #5d6e84; }
.menu .section-title { margin: 0 0 1 0; padding: 0 1; }
.modal-text { padding: 2; height: auto; }
.modal-actions { height: 1; margin-top: 1; align-horizontal: right; }
.modal-actions Button { min-width: 10; height: 1; margin-left: 1; }
#log-scroll { height: 1fr; padding: 1 2; }
#log-text { height: auto; color: #c4d8ea; }

TerminalView { align: center middle; }
TerminalDisplay { width: 1fr; height: 1fr; background: #0b1019; }

GroupForm, NewSession, SessionEdit { align: center middle; background: #050a12 85%; }

TaskSessions { height: auto; }

.terminal-hint { height: 1; padding: 0 1; color: #8d9fb4; }

#ticket-markdown MarkdownH1 { content-align: left middle; text-align: left; color: #f2c94c; background: transparent; text-style: bold; }
#ticket-links { height: auto; padding: 0 1; margin-bottom: 1; }
.dependency-heading { color: #8fa9c6; text-style: bold; }
.dependency { width: 100%; height: 1; padding: 0 1; background: transparent; color: #f2c94c; content-align: left middle; text-align: left; }
.dependency:hover { background: #223146; text-style: underline; }
.dependency:disabled { color: #8d9fb4; }
ColumnMenu .menu { width: 22; }
SourceMenu .menu { width: 22; }

DiffView { width: 30%; min-width: 44; height: 100%; background: #0f1620; border-left: solid #5a6575; layer: base; }
DiffView.-cover { width: 100%; min-width: 0; layer: overlay; border-left: none; }
#diff-top { height: 1; }
#diff-top-spacer { width: 1fr; }
#diff-close { width: 3; min-width: 3; padding: 0; }
#diff-summary { height: 1; padding: 0 1; margin-bottom: 1; }
#diff-title { width: 1fr; height: 1; }
#diff-source { width: auto; min-width: 0; height: 1; padding: 0; background: transparent; color: #d9e4f3; }
#diff-source:hover { text-style: bold underline; }
#diff-files { height: 3; padding: 0 1; border-bottom: solid #5a6575; scrollbar-gutter: stable; background: #0f1620; }
#diff-canvas { height: 1fr; padding: 0 1; scrollbar-gutter: stable; background: #0f1620; }
#cfg-history { height: auto; }
#cfg-history Collapsible { padding: 0; margin-bottom: 1; }
.history-detail { height: auto; padding: 0 1; color: #aebed2; }
#cfg-history Button { min-width: 10; margin: 1 0 0 1; }
#cfg-history-more { margin-top: 1; }
