Screen { background: #0b1019; color: #d9e4f3; }
#root { height: 100%; width: 100%; }
#nav {
    height: 3;
    padding: 0 1;
    background: #141d2c;
    align-vertical: middle;
    border-bottom: solid #334257;
}
#logo { width: 1fr; text-style: bold; color: #7ee5d5; content-align-vertical: middle; }
.nav-button { height: 3; min-width: 11; border: none; color: #9eafc2; background: #141d2c; }
.nav-button.selected { color: #7ee5d5; background: #213447; text-style: bold; }
#execution { height: 3; min-width: 11; }
#content { height: 1fr; width: 100%; }
#bottom { height: 1; padding-left: 2; color: #92a2b4; background: #1c293b; }
#board-page { height: 100%; }
.toolbar { height: 3; background: #111b2b; align-vertical: middle; padding: 0 1; }
.toolbar Button { height: 3; min-width: 12; }
.page-heading { height: 3; width: 1fr; content-align-vertical: middle; text-style: bold; }
#lanes { height: 1fr; width: 100%; padding: 1; overflow-x: auto; }
.lane {
    min-width: 20;
    width: 1fr;
    height: 100%;
    margin-right: 1;
    padding: 1;
    background: #131e2e;
}
.lane-title { text-style: bold; color: #8fa9c6; height: 2; }
.card { height: auto; background: #202e41; padding: 1; margin-bottom: 1; }
.card:focus-within { background: #263d55; }
.card-head { height: auto; }
.card-title { width: 1fr; min-width: 5; background: transparent; border: none; color: #f2f7fd; text-align: left; height: auto; }
.card-menu { width: 4; min-width: 4; border: none; background: #324861; color: #9becdc; }
.card-summary { padding: 0 1; color: #aebed2; height: auto; }
.card-runtime { padding: 0 1; color: #80dccc; height: auto; }
.check-button { border: none; background: #263b4d; }
#sessions-page, #archive-page, #settings {
    height: 100%;
    padding: 1 2;
}
.archive-row { height: 4; margin-bottom: 1; align-vertical: middle; background: #1b2a3a; }
.archive-title { width: 1fr; padding: 0 1; content-align-vertical: middle; }
.session-heading, .section-title {
    text-style: bold;
    color: #b0a0ff;
    margin: 1 0;
}
.field { color: #95a8bf; margin-top: 1; text-style: bold; }
.settings-editor { height: 7; margin-bottom: 1; }
.hint { color: #8d9fb4; padding: 1; height: auto; }
.runtime { color: #7be0d1; min-width: 10; }
.slot-row { height: 4; align-vertical: middle; background: #1d2b3d; margin-bottom: 1; }
.slot-name { width: 1fr; content-align-vertical: middle; padding-left: 1; }
.slot-row Button { min-width: 10; }
BackdropModal {
    align: center middle;
    background: #050a12 85%;
}
.full {
    width: 100%;
    height: 100%;
    background: #101b2a;
    border: none;
    padding: 0;
}
.content { height: 1fr; padding: 1 2; }
.modal-header {
    height: 3;
    background: #223146;
    align-vertical: middle;
    padding: 0 1;
}
.modal-name { width: 1fr; text-style: bold; color: #82ead9; content-align-vertical: middle; }
.modal-header Button { height: 3; min-width: 9; }
.sm {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    background: #182638;
    padding: 1;
}
.sm TextArea { height: 9; }
.modal-text { padding: 2; height: auto; }
.modal-actions { height: 3; align-horizontal: right; }
.modal-actions Button { min-width: 10; height: 3; }
#log-scroll { height: 1fr; padding: 1 2; }
#log-text { height: auto; color: #c4d8ea; }

TerminalView { align: center middle; }
TerminalDisplay { width: 1fr; height: 1fr; background: #0b1019; }

GroupForm, NewSession, SessionActions { align: center middle; background: #050a12 85%; }
